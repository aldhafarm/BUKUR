{
  "manifest_version": 3,
  "name": "البُكور",
  "short_name": "BUKUR",
  "version": "0.2.0",
  "description": "أدواتك في القائمة الجانبية — تبدأ بساعة البكور.",
  "default_locale": "ar",
  "minimum_chrome_version": "120",
  "permissions": [
    "sidePanel",
    "alarms",
    "storage"
  ],
  "side_panel": {
    "default_path": "panel.html"
  },
  "action": {
    "default_title": "افتح البكور"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon.png",
    "48": "icons/icon.png",
    "128": "icons/icon.png"
  },
  "externally_connectable": {
    "matches": [
      "https://bukur.mind8x.com/*"
    ]
  }
}

{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "package.json",
      "**/.*",
      "**/node_modules/**",
      "docs/**",
      "test/**",
      "scripts/**",
      "extension/**",
      "README.md",
      "pro/**",
      "package-lock.json"
    ],
    "headers": [
      {
        "source": "/app/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ]
  }
}
